namespace workrave::dbus
{
template<>
struct DBusMarshall<{{ view.cxx_type }}>
{
  static {{ view.cxx_type }} convert(const QVariant &variant)
  {
    std::list<{{ view.enum_cxx_type }}> items = DBusMarshall<std::list<{{ view.enum_cxx_type }}>>::convert(variant);
    {{ view.cxx_type }} result;
    for (const auto &item : items)
      {
        result |= item;
      }
    return result;
  }
  static void marshall(QDBusArgument &arg, const {{ view.cxx_type }} &value)
  {
    std::list<{{ view.enum_cxx_type }}> items;
    for (unsigned int b = 0; b < workrave::utils::enum_traits<{{ view.enum_cxx_type }}>::bits; ++b)
      {
        auto e = static_cast<{{ view.enum_cxx_type }}>(1 << b);
        if (value.is_set(e))
          {
            items.push_back(e);
          }
      }
    DBusMarshall<std::list<{{ view.enum_cxx_type }}>>::marshall(arg, items);
  }
  static QVariant convert(const {{ view.cxx_type }} &value)
  {
    QDBusArgument arg;
    marshall(arg, value);
    return QVariant::fromValue(arg);
  }
};
} // namespace workrave::dbus
