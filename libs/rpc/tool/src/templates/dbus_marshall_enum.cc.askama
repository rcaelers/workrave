namespace workrave::dbus
{
template<>
struct DBusMarshall<{{ view.cxx_type }}>
{
  static {{ view.cxx_type }} convert(const QVariant &variant)
  {
    QString arg = variant.value<QString>();
    {{ view.cxx_type }} value{};
{% for v in view.values %}
    if ("{{ v.name }}" == arg) { value = {{ v.cxx_symbol }}; }
{% endfor %}
    return value;
  }
  static void marshall(QDBusArgument &arg, const {{ view.cxx_type }} &value)
  {
    std::string str;
    switch (value)
      {
{% for v in view.values %}
      case {{ v.cxx_symbol }}: str = "{{ v.name }}"; break;
{% endfor %}
      default:
        throw workrave::dbus::DBusRemoteException()
          << workrave::dbus::message_info("Type error in enum")
          << workrave::dbus::error_code_info(DBUS_ERROR_INVALID_ARGS);
      }
    arg << QString::fromStdString(str);
  }
  static QVariant convert(const {{ view.cxx_type }} &value)
  {
    std::string str;
    switch (value)
      {
{% for v in view.values %}
      case {{ v.cxx_symbol }}: str = "{{ v.name }}"; break;
{% endfor %}
      default:
        throw workrave::dbus::DBusRemoteException()
          << workrave::dbus::message_info("Type error in enum")
          << workrave::dbus::error_code_info(DBUS_ERROR_INVALID_ARGS);
      }
    return QVariant::fromValue(QString::fromStdString(str));
  }
};
} // namespace workrave::dbus

// ADL requires these at global scope (or a namespace associated with one of
// the parameter types) to be found from Qt's own template code — nesting
// them inside workrave::dbus, where they'd only be found via {{ view.cxx_type }}'s
// own namespace (which may not be workrave::dbus at all), silently breaks
// qDBusRegisterMetaType<{{ view.cxx_type }}>() and any use as a sequence/map element.
[[maybe_unused]] static QDBusArgument &operator<<(QDBusArgument &arg, const {{ view.cxx_type }} &data)
{
  workrave::dbus::DBusMarshall<{{ view.cxx_type }}>::marshall(arg, data);
  return arg;
}

[[maybe_unused]] static const QDBusArgument &operator>>(const QDBusArgument &arg, {{ view.cxx_type }} &data)
{
  QString value;
  arg >> value;
  data = workrave::dbus::DBusMarshall<{{ view.cxx_type }}>::convert(QVariant::fromValue(value));
  return arg;
}
