{%- macro marshall_type(custom, model) -%}
{%- set ty = model.types[custom.type_id] -%}
{%- if custom.kind == "enum" -%}
namespace workrave::dbus
{
template<>
struct DBusMarshall<{{ ty.cxx.spelling }}>
{
  static {{ ty.cxx.spelling }} convert(const QVariant &variant)
  {
    QString arg = variant.value<QString>();
    {{ ty.cxx.spelling }} value{};
{% for value in custom.values %}
    if ("{{ value.canonical_name }}" == arg) { value = {{ value.cxx_symbol }}; }
{% endfor %}
    return value;
  }
  static void marshall(QDBusArgument &arg, const {{ ty.cxx.spelling }} &value)
  {
    std::string str;
    switch (value)
      {
{% for value in custom.values %}
      case {{ value.cxx_symbol }}: str = "{{ value.canonical_name }}"; break;
{% endfor %}
      default:
        throw workrave::dbus::DBusRemoteException()
          << workrave::dbus::message_info("Type error in enum")
          << workrave::dbus::error_code_info(DBUS_ERROR_INVALID_ARGS);
      }
    arg << QString::fromStdString(str);
  }
  static QVariant convert(const {{ ty.cxx.spelling }} &value)
  {
    std::string str;
    switch (value)
      {
{% for value in custom.values %}
      case {{ value.cxx_symbol }}: str = "{{ value.canonical_name }}"; break;
{% endfor %}
      default:
        throw workrave::dbus::DBusRemoteException()
          << workrave::dbus::message_info("Type error in enum")
          << workrave::dbus::error_code_info(DBUS_ERROR_INVALID_ARGS);
      }
    return QVariant::fromValue(QString::fromStdString(str));
  }
};
} // namespace workrave::dbus

// ADL requires these at global scope (or a namespace associated with one of
// the parameter types) to be found from Qt's own template code — nesting
// them inside workrave::dbus, where they'd only be found via {{ ty.cxx.spelling }}'s
// own namespace (which may not be workrave::dbus at all), silently breaks
// qDBusRegisterMetaType<{{ ty.cxx.spelling }}>() and any use as a sequence/map element.
[[maybe_unused]] static QDBusArgument &operator<<(QDBusArgument &arg, const {{ ty.cxx.spelling }} &data)
{
  workrave::dbus::DBusMarshall<{{ ty.cxx.spelling }}>::marshall(arg, data);
  return arg;
}

[[maybe_unused]] static const QDBusArgument &operator>>(const QDBusArgument &arg, {{ ty.cxx.spelling }} &data)
{
  QString value;
  arg >> value;
  data = workrave::dbus::DBusMarshall<{{ ty.cxx.spelling }}>::convert(QVariant::fromValue(value));
  return arg;
}
{%- elif custom.kind == "struct" -%}
namespace workrave::dbus
{
template<>
struct DBusMarshall<{{ ty.cxx.spelling }}>
{
  static {{ ty.cxx.spelling }} convert(const QVariant &variant)
  {
    const auto arg = variant.value<QDBusArgument>();
    {{ ty.cxx.spelling }} result{};
    arg.beginStructure();
{% for field in ty.shape.fields %}
    result.{{ field.cxx_name }} = DBusMarshall<{{ model.types[field.type_id].cxx.spelling }}>::convert(arg.asVariant());
{% endfor %}
    arg.endStructure();
    return result;
  }
  static void marshall(QDBusArgument &arg, const {{ ty.cxx.spelling }} &value)
  {
    arg.beginStructure();
{% for field in ty.shape.fields %}
    DBusMarshall<{{ model.types[field.type_id].cxx.spelling }}>::marshall(arg, value.{{ field.cxx_name }});
{% endfor %}
    arg.endStructure();
  }
  static QVariant convert(const {{ ty.cxx.spelling }} &value)
  {
    QDBusArgument arg;
    marshall(arg, value);
    return QVariant::fromValue(arg);
  }
};
} // namespace workrave::dbus

// See the enum case above for why these are at global scope, not nested in
// workrave::dbus: ADL needs to find them from {{ ty.cxx.spelling }}'s own associated
// namespace, not this library's.
[[maybe_unused]] static QDBusArgument &operator<<(QDBusArgument &arg, const {{ ty.cxx.spelling }} &data)
{
  workrave::dbus::DBusMarshall<{{ ty.cxx.spelling }}>::marshall(arg, data);
  return arg;
}

[[maybe_unused]] static const QDBusArgument &operator>>(const QDBusArgument &arg, {{ ty.cxx.spelling }} &data)
{
  data = workrave::dbus::DBusMarshall<{{ ty.cxx.spelling }}>::convert(QVariant::fromValue(arg));
  return arg;
}
{%- elif custom.kind == "vector" -%}
{%- set element = model.types[custom.element_type] -%}
namespace workrave::dbus
{
template<>
struct DBusMarshall<{{ ty.cxx.spelling }}>
{
  static {{ ty.cxx.spelling }} convert(const QVariant &variant)
  {
    const auto arg = variant.value<QDBusArgument>();
    {{ ty.cxx.spelling }} result;
    arg.beginArray();
    while (!arg.atEnd())
      {
        result.push_back(DBusMarshall<{{ element.cxx.spelling }}>::convert(arg.asVariant()));
      }
    arg.endArray();
    return result;
  }
  static void marshall(QDBusArgument &arg, const {{ ty.cxx.spelling }} &value)
  {
    arg.beginArray(qMetaTypeId<QVariant>());
    for (const auto &item : value)
      {
        DBusMarshall<{{ element.cxx.spelling }}>::marshall(arg, item);
      }
    arg.endArray();
  }
  static QVariant convert(const {{ ty.cxx.spelling }} &value)
  {
    QDBusArgument arg;
    marshall(arg, value);
    return QVariant::fromValue(arg);
  }
};
} // namespace workrave::dbus
{%- elif custom.kind == "duration" -%}
namespace workrave::dbus
{
template<>
struct DBusMarshall<{{ ty.cxx.spelling }}>
{
  static {{ ty.cxx.spelling }} convert(const QVariant &variant)
  {
    std::string text = DBusMarshall<std::string>::convert(variant);
    return std::chrono::duration_cast<{{ ty.cxx.spelling }}>(rpc::parse_duration(text));
  }
};
} // namespace workrave::dbus
{%- elif custom.kind == "bitmask" -%}
{%- set enum_ty = model.types[custom.enum_type] -%}
namespace workrave::dbus
{
template<>
struct DBusMarshall<{{ ty.cxx.spelling }}>
{
  static {{ ty.cxx.spelling }} convert(const QVariant &variant)
  {
    std::list<{{ enum_ty.cxx.spelling }}> items = DBusMarshall<std::list<{{ enum_ty.cxx.spelling }}>>::convert(variant);
    {{ ty.cxx.spelling }} result;
    for (const auto &item : items)
      {
        result |= item;
      }
    return result;
  }
  static void marshall(QDBusArgument &arg, const {{ ty.cxx.spelling }} &value)
  {
    std::list<{{ enum_ty.cxx.spelling }}> items;
    for (unsigned int b = 0; b < workrave::utils::enum_traits<{{ enum_ty.cxx.spelling }}>::bits; ++b)
      {
        auto e = static_cast<{{ enum_ty.cxx.spelling }}>(1 << b);
        if (value.is_set(e))
          {
            items.push_back(e);
          }
      }
    DBusMarshall<std::list<{{ enum_ty.cxx.spelling }}>>::marshall(arg, items);
  }
  static QVariant convert(const {{ ty.cxx.spelling }} &value)
  {
    QDBusArgument arg;
    marshall(arg, value);
    return QVariant::fromValue(arg);
  }
};
} // namespace workrave::dbus
{%- endif -%}
{%- endmacro -%}
