# Read dependency names once, without resolving them against the build machine.
function(_workrave_binary_dependencies binary output)
    execute_process(COMMAND otool -L "${binary}"
        OUTPUT_VARIABLE listing COMMAND_ERROR_IS_FATAL ANY)
    string(REGEX MATCHALL "[^\n\r]+" lines "${listing}")
    set(dependencies)
    foreach(line IN LISTS lines)
        string(STRIP "${line}" line)
        if(line MATCHES "^(.+) \\(compatibility version")
            list(APPEND dependencies "${CMAKE_MATCH_1}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES dependencies)
    set(${output} "${dependencies}" PARENT_SCOPE)
endfunction()

# Work around macdeployqt dropping the common Qt search directory before its
# QML pass when the executable links Qt by absolute names (e.g. split Qt builds).
# Only rewrite references verified against the selected Qt's library directory.
function(workrave_prepare_qt_rpaths binary qt_library_dir)
    _workrave_binary_dependencies("${binary}" dependencies)
    set(changes)
    foreach(original IN LISTS dependencies)
        if(original MATCHES "^/.*/(Qt[^/]+\\.framework/Versions/[^/]+/[^/]+)$")
            set(relative "${CMAKE_MATCH_1}")
        elseif(original MATCHES "^/.*/(libQt[56][^/]+\\.dylib)$")
            set(relative "${CMAKE_MATCH_1}")
        else()
            continue()
        endif()
        set(candidate "${qt_library_dir}/${relative}")
        if(EXISTS "${candidate}")
            file(REAL_PATH "${original}" original_real)
            file(REAL_PATH "${candidate}" candidate_real)
            if(original_real STREQUAL candidate_real)
                list(APPEND changes -change "${original}" "@rpath/${relative}")
            endif()
        endif()
    endforeach()
    if(changes)
        execute_process(COMMAND install_name_tool ${changes} "${binary}"
            COMMAND_ERROR_IS_FATAL ANY)
    endif()
endfunction()

# CMake reinstalls the executable even when deployment is cached. Restore its
# references to the bundled copies, supporting absolute and bare install names.
function(workrave_relocate_bundled_dependencies binary directory)
    _workrave_binary_dependencies("${binary}" dependencies)
    set(changes)
    foreach(original IN LISTS dependencies)
        if(original MATCHES "^(@|/System/Library/|/usr/lib/)")
            continue()
        endif()
        if(original MATCHES "/([^/]+\\.framework/.*)$")
            set(relative "${CMAKE_MATCH_1}")
        else()
            get_filename_component(relative "${original}" NAME)
        endif()
        if(NOT EXISTS "${directory}/${relative}")
            message(FATAL_ERROR "Dependency was not deployed: ${original}")
        endif()
        list(APPEND changes -change "${original}" "@rpath/${relative}")
    endforeach()
    if(changes)
        execute_process(COMMAND install_name_tool ${changes} "${binary}"
            COMMAND_ERROR_IS_FATAL ANY)
    endif()
endfunction()

# Drop build-machine fallback paths after bundling. Deduplicate universal slices.
function(workrave_remove_external_rpaths binary)
    execute_process(COMMAND otool -l "${binary}"
        OUTPUT_VARIABLE listing COMMAND_ERROR_IS_FATAL ANY)
    string(REGEX MATCHALL "path /[^\n\r]+ \\(offset" entries "${listing}")
    list(REMOVE_DUPLICATES entries)
    set(changes)
    foreach(entry IN LISTS entries)
        string(REGEX REPLACE "^path (.*) \\(offset$" "\\1" path "${entry}")
        list(APPEND changes -delete_rpath "${path}")
    endforeach()
    if(changes)
        execute_process(COMMAND install_name_tool ${changes} "${binary}"
            COMMAND_ERROR_IS_FATAL ANY)
    endif()
endfunction()
