    <file alias="Theme.qml">qml/PrefWidgets/Theme.qml</file>
    <file alias="Page.qml">qml/PrefWidgets/Page.qml</file>
    <file alias="PrefGroup.qml">qml/PrefWidgets/PrefGroup.qml</file>
    <file alias="PrefToggleRow.qml">qml/PrefWidgets/PrefToggleRow.qml</file>
    <file alias="PrefStepper.qml">qml/PrefWidgets/PrefStepper.qml</file>
    <file alias="PrefTimeStepper.qml">qml/PrefWidgets/PrefTimeStepper.qml</file>
    <file alias="PrefSliderRow.qml">qml/PrefWidgets/PrefSliderRow.qml</file>
