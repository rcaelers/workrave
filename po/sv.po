#: ui/app/org.workrave.gui.gschema.xml.in:10
msgid "Preferred screen lock method"
msgstr "Föredragen metod för att låsa skärmen"

#: ui/app/org.workrave.gui.gschema.xml.in:11
msgid "Identifier of the screen lock method used by break windows. An empty value selects the first available method."
msgstr "Identifierare för den metod som pausfönstren använder för att låsa skärmen. Lämna värdet tomt för att välja den första tillgängliga metoden."

#: ui/app/org.workrave.gui.gschema.xml.in:15
msgid "Preferred sleep operation"
msgstr "Föredraget strömsparläge"

#: ui/app/org.workrave.gui.gschema.xml.in:16
msgid "System sleep operation used by break windows."
msgstr "Det strömsparläge som pausfönstren använder."

#: ui/app/org.workrave.gui.gschema.xml.in:20
msgid "Custom screen lock command"
msgstr "Eget kommando för att låsa skärmen"

#: ui/app/org.workrave.gui.gschema.xml.in:21
msgid "Command to execute when the custom screen lock method is selected."
msgstr "Kommando som körs när en egen metod för skärmlås har valts."

#: ui/app/org.workrave.gui.gschema.xml.in:51
msgid "Interface color scheme"
msgstr "Gränssnittets färgschema"

#: ui/app/org.workrave.gui.gschema.xml.in:52
