#: libs/corenext/src/org.workrave.gschema.xml.in:246
#: libs/core/src/org.workrave.gschema.xml.in:262
msgid "Use a Unix-domain socket or a loopback TCP/IP socket."
msgstr "Använd en Unix-domänsocket eller en TCP/IP-socket på loopbackgränssnittet."

