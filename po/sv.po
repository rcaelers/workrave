msgid "TCP port used when the gRPC transport is set to TCP/IP."
msgstr "TCP-port som används när TCP/IP har valts som transport för gRPC."

#: ui/app/Application.cc:469
msgid "Workrave could not monitor your keyboard and mouse activity.\n"
msgstr "Workrave kunde inte registrera tangentbords- och musaktiviteten.\n"

#: ui/app/Application.cc:694
msgid "Workrave is still running. You can access Workrave by clicking on the white sheep icon. Click on this balloon to disable this message"
msgstr "Workrave körs fortfarande. Klicka på ikonen med det vita fåret för att öppna Workrave. Klicka på det här meddelandet om du inte vill se det igen."

#: ui/app/Application.cc:710
msgid ""
"Workrave is in suspended mode.\n"
"Mouse and keyboard activity will not be monitored."
msgstr ""
"Workrave är pausat.\n"
"Tangentbords- och musaktiviteten registreras inte."

#: ui/app/Application.cc:718
msgid "Workrave is in quiet mode. No break windows will appear."
msgstr "Workrave är i tyst läge. Inga pausfönster visas."

