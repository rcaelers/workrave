msgid "Timer display style"
msgstr "Timrarnas utseende"

#: ui/app/org.workrave.gui.gschema.xml.in:78
msgid "Select the visual style used to display timers."
msgstr "Välj hur timrarna ska visas."

#: ui/app/org.workrave.gui.gschema.xml.in:297
msgid "Hide the status window from the taskbar"
msgstr "Dölj statusfönstret i aktivitetsfältet"

#: ui/app/org.workrave.gui.gschema.xml.in:298
msgid "Hide the status window from the taskbar and window switcher."
msgstr "Dölj statusfönstret i aktivitetsfältet och fönsterväxlaren."

