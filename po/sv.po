#: libs/corenext/src/org.workrave.gschema.xml.in:236
#: libs/core/src/org.workrave.gschema.xml.in:252
msgid "Enable the gRPC server"
msgstr "Aktivera gRPC-servern"

#: libs/corenext/src/org.workrave.gschema.xml.in:237
#: libs/core/src/org.workrave.gschema.xml.in:253
msgid "Allow local applications to control Workrave through gRPC."
msgstr "Tillåt lokala program att styra Workrave via gRPC."

#: libs/corenext/src/org.workrave.gschema.xml.in:245
#: libs/core/src/org.workrave.gschema.xml.in:261
