msgid "Workrave picks this many at random from its library each rest break."
msgstr "休憩のたびに、Workraveのライブラリからこの数だけランダムに選びます。"

#: ui/app/toolkits/qt/qml/SoundsPrefPage.qml:30
msgid "Enable sounds"
msgstr "サウンドを有効にする"

#: ui/app/toolkits/qt/qml/SoundsPrefPage.qml:31
